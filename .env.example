# Anthropic API key. Leave unset to run fully offline: sample patients use curated profiles and precomputed reviews against the bundled registry snapshot; other records use the keyword heuristics.
ANTHROPIC_API_KEY=

# Model id for live extraction and matching (default claude-opus-5-5). The UI reads it from /api/status.
TRIAL_MATCHER_MODEL=claude-opus-5-5

# Reasoning effort for record structuring: low | medium | high | xhigh | max (default high).
TRIAL_MATCHER_EXTRACT_EFFORT=high

# Reasoning effort for per-trial criteria matching, 16 calls per patient: low | medium | high | xhigh | max (default medium).
TRIAL_MATCHER_MATCH_EFFORT=medium

# Set to 0 to always serve the bundled registry snapshot instead of querying ClinicalTrials.gov live (default 1 = live when reachable).
TRIAL_MATCHER_LIVE_REGISTRY=1

# Country a study must have a site in to pass the pre-screen (exact ClinicalTrials.gov country name).
# Default "United States"; set to an empty value to disable the location gate. The precomputed sample
# reviews assume the default.
TRIAL_MATCHER_COUNTRY=United States

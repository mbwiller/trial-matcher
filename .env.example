# Anthropic API key. Leave unset to run fully offline: demo patients use curated profiles and matches, other records use the keyword heuristics.
ANTHROPIC_API_KEY=

# Model id for live extraction and matching (default claude-opus-5-5). The UI reads it from /api/status.
TRIAL_MATCHER_MODEL=claude-opus-5-5

# Reasoning effort for record structuring: low | medium | high | xhigh | max (default high).
TRIAL_MATCHER_EXTRACT_EFFORT=high

# Reasoning effort for per-trial criteria matching, ~20 calls per patient: low | medium | high | xhigh | max (default medium).
TRIAL_MATCHER_MATCH_EFFORT=medium

# Set to 0 to always serve the bundled trial fixture instead of querying ClinicalTrials.gov live (default 1 = live when reachable).
TRIAL_MATCHER_LIVE_REGISTRY=1
